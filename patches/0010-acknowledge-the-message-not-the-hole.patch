diff --git a/vendor/c-toxcore/toxcore/group_connection.c b/vendor/c-toxcore/toxcore/group_connection.c
index a49a0fd..2b6a217 100644
--- a/vendor/c-toxcore/toxcore/group_connection.c
+++ b/vendor/c-toxcore/toxcore/group_connection.c
@@ -625,6 +625,41 @@ static bool process_recv_array_entry(const GC_Session *_Nonnull c, GC_Chat *_Non
     peer_number = get_peer_number_of_enc_pk(chat, sender_pk, false);
     gconn = get_gc_connection(chat, peer_number);
 
+    /* p2p-poker: read the id BEFORE the entry is wiped.
+     *
+     * clear_array_entry does `*array_entry = (GC_Message_Array_Entry){nullptr}`,
+     * which zeroes the whole struct including message_id -- and both
+     * gc_send_message_ack calls below read `array_entry->message_id` AFTER it.
+     * So every message drained from the receive array was acknowledged with
+     * **id 0**.
+     *
+     * What that costs, and it is not cosmetic. gcc_handle_ack looks up index
+     * 0 % GCC_BUFFER_SIZE, finds either an empty slot (a silent no-op) or a
+     * different id, and logs "Wrap-around on message 0" and returns false. The
+     * sender's entry for the message that actually arrived is therefore NEVER
+     * cleared by this path. Its time_added never moves, and gcc_resend_packets
+     * drops the peer when the head entry is GC_CONFIRMED_PEER_TIMEOUT = 58 s
+     * old.
+     *
+     * The only thing that rescued such an entry was a later BLIND resend
+     * producing a duplicate of an already-consumed message, which takes the
+     * lossless_ret == 0 path and acks with the correct id. That is why the
+     * whole-window retransmission looked load-bearing: it was acting as the
+     * send array's garbage collector, because the real acknowledgement was
+     * broken. Two adversarial readings independently found that removing the
+     * tail resend would time every peer out on a healthy link, and this is why.
+     *
+     * Fingerprint, measured in split101212-10: **108** lines of "Wrap-around on
+     * message 0". Zero in the run before it -- not because the bug was absent
+     * but because `patches/0009` had not landed yet, so the receive array
+     * drained far less often and this path ran far less often. 0009 did not
+     * cause it; it exposed it.
+     *
+     * Also note the failure branch: asking for the id that just failed is what
+     * the original intended, and with the id preserved that is what it does.
+     */
+    const uint64_t entry_message_id = array_entry->message_id;
+
     clear_array_entry(chat->mem, array_entry);
 
     if (gconn == nullptr) {
@@ -632,11 +667,11 @@ static bool process_recv_array_entry(const GC_Session *_Nonnull c, GC_Chat *_Non
     }
 
     if (!ret) {
-        gc_send_message_ack(chat, gconn, array_entry->message_id, GR_ACK_REQ);
+        gc_send_message_ack(chat, gconn, entry_message_id, GR_ACK_REQ);
         return false;
     }
 
-    gc_send_message_ack(chat, gconn, array_entry->message_id, GR_ACK_RECV);
+    gc_send_message_ack(chat, gconn, entry_message_id, GR_ACK_RECV);
 
     gcc_set_recv_message_id(gconn, gconn->received_message_id + 1);
 
