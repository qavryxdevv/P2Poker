# 0033 - the friend a group member came in through can be read.
#
# S1-DV (2026-09-12): the owner's screenshot -- a founder at "waiting for
# players, 2 of 2" with an opponent that had left before the first hand still
# green on the felt -- and his rule that nothing may wait for ever before the
# first hand, for a leave and for lost lines alike. Before a hand the client
# has no way to say which seat a group member is: it learns that from signed
# hand traffic, and there is none yet. So a member's QUIT, timeout or silence
# mapped to no seat, and the felt kept a seat that was gone.
#
# The library already records, on both sides of an invitation, the friend
# number it travelled over (GC_Connection.friend_number, set in
# handle_gc_invite_accepted_packet and handle_gc_invite_confirmed_packet).
# This adds an accessor, tox_group_peer_friend_number: that friend number for
# a member given by its group public key, UINT32_MAX when the group or the
# peer is not found or the member came some other way. It reads local memory
# and sends nothing; the wire is untouched, so a patched client and an
# unpatched one keep speaking to each other. A founder knows every seat it
# invited from the moment it joins, and a joiner knows its founder.
#
# Applied to the vendored tree in place; this file is the record. The marker
# tools/build-tox.ps1 checks for is the comment in tox.h.
diff --git a/vendor/c-toxcore/toxcore/tox.c b/vendor/c-toxcore/toxcore/tox.c
index 37f1e17..bea2a67 100644
--- a/vendor/c-toxcore/toxcore/tox.c
+++ b/vendor/c-toxcore/toxcore/tox.c
@@ -4219,6 +4219,41 @@ uint64_t tox_group_peer_quiet_secs(const Tox *_Nonnull tox, uint32_t group_numbe
     return (last == 0 || now < last) ? UINT64_MAX : now - last;
 }
 
+uint32_t tox_group_peer_friend_number(const Tox *_Nonnull tox, uint32_t group_number,
+                                      const uint8_t *_Nonnull peer_public_key)
+{
+    assert(tox != nullptr);
+
+    tox_lock(tox);
+    const GC_Chat *chat = gc_get_group(tox->m->group_handler, group_number);
+
+    if (chat == nullptr) {
+        tox_unlock(tox);
+        return UINT32_MAX;
+    }
+
+    const int peer_number = get_peer_number_of_enc_pk(chat, peer_public_key, false);
+
+    if (peer_number < 0) {
+        tox_unlock(tox);
+        return UINT32_MAX;
+    }
+
+    const GC_Connection *gconn = get_gc_connection(chat, peer_number);
+
+    if (gconn == nullptr) {
+        tox_unlock(tox);
+        return UINT32_MAX;
+    }
+
+    /* p2p-poker (patch 0033): the friend the invitation travelled over, set on
+     * both sides of it by the library already; -1 when the member came some
+     * other way. */
+    const int32_t friend_number = gconn->friend_number;
+    tox_unlock(tox);
+    return friend_number < 0 ? UINT32_MAX : (uint32_t)friend_number;
+}
+
 bool tox_group_send_custom_packet(const Tox *_Nonnull tox, uint32_t group_number, bool lossless, const uint8_t *_Nonnull data,
                                   size_t length, Tox_Err_Group_Send_Custom_Packet *_Nullable error)
 {
diff --git a/vendor/c-toxcore/toxcore/tox.h b/vendor/c-toxcore/toxcore/tox.h
index ac502a5..96cd112 100644
--- a/vendor/c-toxcore/toxcore/tox.h
+++ b/vendor/c-toxcore/toxcore/tox.h
@@ -4533,6 +4533,16 @@ uint64_t tox_group_peer_quiet_secs(
     const Tox *tox, Tox_Group_Number group_number,
     const uint8_t peer_public_key[]);
 
+/**
+ * p2p-poker (patch 0033): the friend this member came into the group through
+ * -- the friend number its invitation travelled over, on either side of it --
+ * or UINT32_MAX when the group or the peer is not found or the member came
+ * some other way. Reads local memory and sends nothing.
+ */
+uint32_t tox_group_peer_friend_number(
+    const Tox *tox, Tox_Group_Number group_number,
+    const uint8_t peer_public_key[]);
+
 typedef enum Tox_Err_Group_Send_Custom_Private_Packet {
 
     /**
